<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="simple_sale_view_list" model="ir.ui.view">
        <field name="name">simple.sale.list</field>
        <field name="model">simple.sale</field>
        <field name="arch" type="xml">
            <list string="Simple Sales">
                <field name="name"/>
                <field name="quantity"/>
                <field name="unit_price"/>
                <field name="total" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="simple_sale_view_form" model="ir.ui.view">
        <field name="name">simple.sale.form</field>
        <field name="model">simple.sale</field>
        <field name="arch" type="xml">
            <form string="Simple Sale">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="quantity"/>
                        <field name="unit_price"/>
                        <field name="total" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="simple_sale_action" model="ir.actions.act_window">
        <field name="name">Sales Entries</field>
        <field name="res_model">simple.sale</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="simple_sale_root_menu" name="Simple Sales" sequence="50"/>
    <menuitem id="simple_sale_entries_menu" name="Sales Entries"
              parent="simple_sale_root_menu" action="simple_sale_action" sequence="10"/>
</odoo>
